// use prisma-next

model User {

  id              Int       @id @default(autoincrement())

  username        String    @unique

  email           String    @unique

  passwordHash    String

  emailVerified   Boolean   @default(false)

  createdAt       DateTime  @default(now())

  updatedAt       temporal.updatedAt()

  emailVerificationTokens EmailVerificationToken[]

  passwordChangeTokens PasswordChangeToken[]

  accountDeletionTokens AccountDeletionToken[]

  devices Device[]

  deviceRegistrationTokens DeviceRegistration[]

  sessions Session[]
  
}

model EmailVerificationToken {

  id        Int       @id @default(autoincrement())

  tokenHash String    @unique

  userId    Int

  expiresAt DateTime

  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

}

model Session {

  id               Int      @id @default(autoincrement())

  sessionTokenHash  String   @unique

  userId            Int

  expiresAt         DateTime

  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

}

model PasswordChangeToken {
  id           Int      @id @default(autoincrement())
  tokenHash    String   @unique
  userId       Int
  passwordHash String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
}

model AccountDeletionToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Device {
  id          Int      @id @default(autoincrement())
  userId      Int
  udid        String   @unique
  model       String?
  product     String?
  osVersion   String?
  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()

  user User @relation(fields: [userId], references: [id])
}

model DeviceRegistration {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}