// use prisma-next

model User {

  id              Int       @id @default(autoincrement())

  username        String    @unique

  email           String    @unique

  passwordHash    String

  emailVerified   Boolean   @default(false)

  tokenBalance    Int       @default(0)

  role            String    @default("USER")

  emailVerificationTokens EmailVerificationToken[]

  passwordChangeTokens    PasswordChangeToken[]

  accountDeletionTokens   AccountDeletionToken[]

  devices                  Device[]

  deviceRegistrations      DeviceRegistration[]

  sessions                 Session[]

  tokenPurchases           TokenPurchase[]

  tokenTransactions        TokenTransaction[]

  certificateOrders        CertificateOrder[]

}


model EmailVerificationToken {

  id        Int      @id @default(autoincrement())

  tokenHash String   @unique

  userId    Int

  expiresAt DateTime

  user User @relation(fields: [userId], references: [id])

}


model Session {

  id               Int      @id @default(autoincrement())

  sessionTokenHash String   @unique

  userId           Int

  expiresAt        DateTime

  user User @relation(fields: [userId], references: [id])

}


model PasswordChangeToken {

  id           Int      @id @default(autoincrement())

  tokenHash    String   @unique

  userId       Int

  passwordHash String

  expiresAt    DateTime

  user User @relation(fields: [userId], references: [id])

}


model AccountDeletionToken {

  id        Int      @id @default(autoincrement())

  tokenHash String   @unique

  userId    Int

  expiresAt DateTime

  user User @relation(fields: [userId], references: [id])

}


model Device {

  id      Int    @id @default(autoincrement())

  userId  Int

  udid    String @unique

  product String

  build   String

  user User @relation(fields: [userId], references: [id])

  certificateOrders CertificateOrder[]

}


model DeviceRegistration {

  id        Int      @id @default(autoincrement())

  tokenHash String   @unique

  userId    Int

  expiresAt DateTime

  user User @relation(fields: [userId], references: [id])

}


model DeviceModelCache {

  product String @id

  model   String

  build   String

  version String

}


// ─────────────────────────────────────────────
// TOKEN PACKAGES
// ─────────────────────────────────────────────

model TokenPackage {

  id              Int     @id @default(autoincrement())

  name            String

  tokens          Int

  price           Decimal

  ppqcheckBudget  Decimal

  active          Boolean @default(true)

}


// ─────────────────────────────────────────────
// ACTIVE TOKEN PURCHASES
//
// Questo modello NON è uno storico.
// Esiste solamente mentre un acquisto è
// in corso di elaborazione.
// ─────────────────────────────────────────────

model TokenPurchase {

  id            Int      @id @default(autoincrement())

  userId        Int

  tokens        Int

  createdAt     DateTime @default(now())

  amount        Decimal

  paymosOrderId String   @unique

  status        TokenPurchaseStatus

  user User @relation(fields: [userId], references: [id])

  ppqcheckTransaction PpqcheckTransaction?

}


// ─────────────────────────────────────────────
// PAYMOS WEBHOOK DEDUPLICATION
// ─────────────────────────────────────────────

model PaymosWebhookEvent {

  id        Int    @id @default(autoincrement())

  eventId   String @unique

  eventType String

}


// ─────────────────────────────────────────────
// TOKEN TRANSACTIONS
//
// Nessuna transazione viene creata per
// l'acquisto dei token.
//
// Rimangono solamente le movimentazioni
// reali dei token legate ai certificati
// e agli eventuali rimborsi.
// ─────────────────────────────────────────────

model TokenTransaction {

  id      Int                  @id @default(autoincrement())

  userId  Int

  amount  Int

  type    TokenTransactionType

  orderId Int?                @unique

  user  User              @relation(fields: [userId], references: [id])

  order CertificateOrder? @relation(fields: [orderId], references: [id])

}


// ─────────────────────────────────────────────
// CERTIFICATE TYPES
// ─────────────────────────────────────────────

model CertificateType {

  id                Int     @id @default(autoincrement())

  name              String

  tokens            Int

  validityDays      Int

  antiRevokeDays    Int?

  ppqcheckId        String  @unique

  ppqcheckCost      Decimal

  active            Boolean @default(true)

  orders CertificateOrder[]

}


// ─────────────────────────────────────────────
// CERTIFICATE ORDERS
// ─────────────────────────────────────────────

model CertificateOrder {

  id                 Int      @id @default(autoincrement())

  userId             Int

  deviceId           Int

  certificateTypeId  Int

  tokens             Int

  ppqcheckOrderId    String?  @unique

  status             CertificateOrderStatus

  user            User            @relation(fields: [userId], references: [id])

  device          Device          @relation(fields: [deviceId], references: [id])

  certificateType CertificateType @relation(fields: [certificateTypeId], references: [id])

  tokenTransaction    TokenTransaction?

  ppqcheckTransaction PpqcheckTransaction?

}


// ─────────────────────────────────────────────
// TOKEN PURCHASE STATUS
// ─────────────────────────────────────────────

enum TokenPurchaseStatus {

  PENDING

  PAID

  PAID_FUNDING

}


// ─────────────────────────────────────────────
// TOKEN TRANSACTION TYPE
// ─────────────────────────────────────────────

enum TokenTransactionType {

  CERTIFICATE

  REFUND

}


// ─────────────────────────────────────────────
// CERTIFICATE ORDER STATUS
// ─────────────────────────────────────────────

enum CertificateOrderStatus {

  PENDING

  PROCESSING

  WAITING_APPLE_APPROVED

  SUCCESS

  FAILED

  CANCELLED

}


// ─────────────────────────────────────────────
// SYNC CREDIT
// ─────────────────────────────────────────────

model SyncCredit {

  id           Int     @id @default(autoincrement())

  ppqAmount    Decimal @default("0")

  ppqCoverage  Decimal @default("0")

}


// ─────────────────────────────────────────────
// PPQCHECK TRANSACTIONS
// ─────────────────────────────────────────────

model PpqcheckTransaction {

  id                    Int      @id @default(autoincrement())

  type                  PpqcheckTransactionType

  amount                Decimal

  tokenPurchaseId       Int?     @unique

  certificateOrderId    Int?     @unique

  description           String?

  fundingStatus         PpqcheckFundingStatus?

  externalOrderId       String?

  ppqDepositId          String?

  ppqDepositAddress     String?

  ppqDepositAmount      Decimal?

  ppqDepositNetwork     String?

  ppqDepositExpiresAt   DateTime?

  paymosWithdrawalId   String?

  paymosWithdrawalStatus String?

  tokenPurchase       TokenPurchase?    @relation(fields: [tokenPurchaseId], references: [id])

  certificateOrder    CertificateOrder? @relation(fields: [certificateOrderId], references: [id])

}


// ─────────────────────────────────────────────
// PPQCHECK FUNDING STATUS
// ─────────────────────────────────────────────

enum PpqcheckFundingStatus {

  PENDING

  COMPLETED

  FAILED

}


// ─────────────────────────────────────────────
// PPQCHECK TRANSACTION TYPE
// ─────────────────────────────────────────────

enum PpqcheckTransactionType {

  CREDIT

  CERTIFICATE_COST

  REFUND

  ADJUSTMENT

}